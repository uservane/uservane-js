{
  "name": "@uservane/copilotkit",
  "version": "0.1.0",
  "description": "UserVane frontend capture for CopilotKit (deterministic turn-resolution feedback)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@copilotkit/react-core": ">=1.63",
    "react": ">=18"
  },
  "dependencies": {
    "@uservane/agent-core": "workspace:*",
    "@uservane/agent-react": "workspace:*"
  },
  "devDependencies": {
    "@copilotkit/react-core": "1.63.2",
    "@copilotkit/react-ui": "1.63.2",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uservane/uservane-js.git",
    "directory": "packages/copilotkit"
  },
  "homepage": "https://github.com/uservane/uservane-js/tree/main/packages/copilotkit#readme",
  "bugs": {
    "url": "https://github.com/uservane/uservane-js/issues"
  }
}
