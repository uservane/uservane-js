{
  "name": "@uservane/vercel-ai",
  "version": "0.1.1",
  "description": "Agent-native UserVane capture for Vercel AI SDK agents",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "pnpm build && node scripts/check-size.mjs"
  },
  "peerDependencies": {
    "ai": ">=5",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@uservane/agent-core": "workspace:*",
    "@uservane/agent-react": "workspace:*",
    "@uservane/browser": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "ai": "7.0.66",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.0.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uservane/uservane-js.git",
    "directory": "packages/vercel-ai"
  },
  "homepage": "https://github.com/uservane/uservane-js/tree/main/packages/vercel-ai#readme",
  "bugs": {
    "url": "https://github.com/uservane/uservane-js/issues"
  }
}
