{
  "name": "@uservane/react-native",
  "version": "0.1.1",
  "description": "React Native SDK for UserVane honest microsurveys",
  "keywords": [
    "nps",
    "csat",
    "ces",
    "survey",
    "user-feedback",
    "customer-feedback",
    "uservane",
    "react-native",
    "mobile-survey",
    "expo"
  ],
  "license": "MIT",
  "author": "Kevin O'Shea <kevin@myuid.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72"
  },
  "dependencies": {
    "@uservane/browser": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.0",
    "@types/react": "^18.3.18",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uservane/uservane-js.git",
    "directory": "packages/react-native"
  },
  "homepage": "https://github.com/uservane/uservane-js/tree/main/packages/react-native#readme",
  "bugs": {
    "url": "https://github.com/uservane/uservane-js/issues"
  }
}
