{
  "name": "@uservane/agent-core",
  "version": "0.1.0",
  "description": "Framework-agnostic headless agent controller for UserVane capture",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@uservane/browser": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "jsdom": "^26.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uservane/uservane-js.git",
    "directory": "packages/agent-core"
  },
  "homepage": "https://github.com/uservane/uservane-js/tree/main/packages/agent-core#readme",
  "bugs": {
    "url": "https://github.com/uservane/uservane-js/issues"
  }
}
