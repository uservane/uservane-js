# UserVane (from https://api.uservane.com dashboard → project keys)
NEXT_PUBLIC_USERVANE_KEY=uv_pk_...
USERVANE_SECRET_KEY=uv_sk_...

# Survey: create a CSAT (or CES) survey in UserVane with slug "post-task"
# Optional: pin minting to a survey id (surv_...) instead of slug-only client open
# USERVANE_SURVEY_ID=surv_...

# Model: any OpenAI-compatible API the Vercel AI SDK can call.
# Example with OpenAI:
OPENAI_API_KEY=sk-...
# Optional model id (default gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini
